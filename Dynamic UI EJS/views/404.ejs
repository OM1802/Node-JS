<%- include('partials/head') %>
  </head>

  <body class="bg-gray-50 text-gray-900 min-h-screen">

    <!-- Header -->
    <%- include('partials/nav') %>


    <!-- 404 Content -->
    <main class="min-h-[calc(100vh-81px)] flex items-center justify-center px-6">

      <div class="text-center max-w-lg">

        <!-- 404 -->
        <h1 class="text-8xl md:text-9xl font-bold text-red-500 tracking-tight">
          404
        </h1>

        <h2 class="text-3xl md:text-4xl font-bold text-gray-900 mt-4">
          Page not found
        </h2>

        <p class="text-gray-500 text-lg mt-4 leading-relaxed">
          Sorry, we couldn't find the page you're looking for.
          It may have been moved, deleted, or the URL might be incorrect.
        </p>


        <!-- Button -->
        <div class="mt-8">
          <a
            href="/"
            class="inline-block bg-red-500 hover:bg-red-600 text-white font-semibold px-7 py-3 rounded-xl transition duration-200 shadow-sm"
          >
            Go Back Home
          </a>
        </div>

      </div>

    </main>

  </body>
</html>