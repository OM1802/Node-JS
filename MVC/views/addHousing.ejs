<%- include('partials/head') %>
  </head>

  <body class="bg-gray-50 text-gray-900">

    <!-- Header -->
    <%- include('partials/nav') %>


    <!-- Main -->
    <main class="max-w-2xl mx-auto px-6 py-12">

      <!-- Heading -->
      <div class="mb-8">
        <p class="text-sm font-semibold text-red-500 uppercase tracking-wide">
          Become a host
        </p>

        <h1 class="text-3xl md:text-4xl font-bold mt-2">
          Register your home
        </h1>

        <p class="text-gray-500 mt-3">
          Tell us about your property and start listing it on Airbnb.
        </p>
      </div>


      <!-- Form Card -->
      <div class="bg-white rounded-2xl border border-gray-200 shadow-sm p-6 md:p-8">

        <form action="/host/add-housing" method="POST" class="space-y-6">

          <!-- House Name -->
          <div>
            <label
              for="houseName"
              class="block text-sm font-semibold text-gray-800 mb-2"
            >
              Property name
            </label>

            <input
              id="houseName"
              type="text"
              name="houseName"
              placeholder="e.g. Goa Beach Villa"
              required
              class="w-full px-4 py-3 border border-gray-300 rounded-xl outline-none focus:ring-2 focus:ring-red-400 focus:border-red-400 transition"
            />

            <p class="text-xs text-gray-500 mt-2">
              Choose a name that helps guests understand your property.
            </p>
          </div>


          <!-- Submit -->
          <button
            type="submit"
            class="w-full bg-red-500 hover:bg-red-600 text-white font-semibold py-3 px-5 rounded-xl transition duration-200 shadow-sm"
          >
            Register Home
          </button>

        </form>

      </div>

    </main>

  </body>
</html>