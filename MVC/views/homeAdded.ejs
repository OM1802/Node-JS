<%- include('partials/head') %>
  </head>

  <body class="bg-gray-50 text-gray-900 min-h-screen">

    <!-- Header -->
    <%- include('partials/nav') %>


    <!-- Success Content -->
    <main class="min-h-[calc(100vh-81px)] flex items-center justify-center px-6">

      <div
        class="bg-white border border-gray-200 rounded-3xl shadow-sm p-8 md:p-12 max-w-lg w-full text-center"
      >

        <!-- Success Icon -->
        <div
          class="mx-auto w-16 h-16 rounded-full bg-green-100 flex items-center justify-center mb-6"
        >
          <span class="text-3xl text-green-600">✓</span>
        </div>


        <!-- Heading -->
        <h1 class="text-3xl md:text-4xl font-bold text-gray-900">
          Home added successfully!
        </h1>

        <p class="text-gray-500 mt-4 leading-relaxed">
          Congratulations! Your property has been successfully registered
          and is now available in your home listings.
        </p>


        <!-- Actions -->
        <div class="mt-8 flex flex-col sm:flex-row gap-3 justify-center">

          <a
            href="/"
            class="bg-red-500 hover:bg-red-600 text-white font-semibold px-6 py-3 rounded-xl transition duration-200"
          >
            View Homes
          </a>

          <a
            href="/host/add-housing"
            class="border border-gray-300 hover:bg-gray-50 text-gray-700 font-semibold px-6 py-3 rounded-xl transition duration-200"
          >
            Add Another Home
          </a>

        </div>

      </div>

    </main>

  </body>
</html>